# syntax=docker/dockerfile:1
# Free-host variant (Render free, Koyeb, HF Spaces…): the disk is wiped on every restart, so the
# database is restored from an S3/R2 bucket on boot and streamed back within ~1 second of every write.

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-slim
ARG TARGETARCH
ARG LITESTREAM_VERSION=0.3.13
ENV NODE_ENV=production \
    BPD_DATA_DIR=/data \
    BPD_WORKERS=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-${TARGETARCH:-amd64}.tar.gz" | tar -xz -C /usr/local/bin litestream \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server
COPY deploy/litestream.yml /etc/litestream.yml
COPY deploy/free-start.sh /usr/local/bin/free-start
RUN chmod +x /usr/local/bin/free-start && mkdir -p /data && chown node:node /data
USER node
EXPOSE 8787
CMD ["free-start"]

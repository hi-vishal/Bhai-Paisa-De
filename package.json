{
  "name": "bhai-paise-de",
  "version": "3.0.0",
  "private": true,
  "description": "Split bills with friends and get paid back by UPI in a tap. Group chat, shared kitty, PDF statements.",
  "author": "Vishal",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "BPD_API_PORT=8787 tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && npm run build:server",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --enable-source-maps dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test shared/*.test.ts server/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "ledger:verify": "tsx scripts/ledger-verify.ts",
    "solana:check": "tsx scripts/solana-check.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist-server/index.js --log-level=warning",
    "loadtest": "tsx scripts/loadtest.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "framer-motion": "^12.43.0",
    "jsqr": "^1.4.0",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/autocannon": "^7.12.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}

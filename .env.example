# Copy to .env and fill in. Every value here is optional.

# Your public https URL (link previews on WhatsApp, push notifications, logs)
BPD_PUBLIC_URL=https://paise.example.com

# "Support" tip jar in Help and Me: a UPI ID that tips go to, and the name shown. Hidden when unset.
# BPD_TIP_UPI=yourname@okaxis
# BPD_TIP_NAME=Vishal

# Secrets: 64 hex chars each (openssl rand -hex 32). If unset they're generated into data/ on first boot.
# Put them in your secret manager so a lost disk doesn't lose them.
# BPD_NOSTR_SECRET=     # signs every history entry (keep it forever: old and new entries must match)
# BPD_AUTH_SECRET=      # signs login challenges

# --- optional crypto payments (USDT / SOL on Solana) ---
# Off in production until you choose a network: mainnet-beta = real money, devnet = free test money.
# BPD_SOLANA_CLUSTER=mainnet-beta
# A dedicated Solana RPC (Helius, QuickNode, Triton, Alchemy). The public endpoint rate-limits hard.
# The URL (and any API key in it) never reaches browsers: the app relays RPC through the server.
# BPD_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=...
# BPD_SOLANA_COMMITMENT=confirmed   # or finalized (slower, ~13s)
# BPD_SOLANA_PRIORITY=50000         # micro-lamports per CU on wallet sends (mainnet default)
# BPD_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# BPD_DEMO_WALLET=0                 # "simulate payment" on crypto quotes (default on in dev, off in production)

# --- tuning ---
# BPD_WORKERS=4                 # HTTP processes (default: CPU cores, max 4, in production)
# BPD_TRUST_PROXY=1             # proxy hops in front of the app (Caddy/Fly/Render = 1; 0 if none)
# BPD_FLOOD_PER_MIN=900         # per-IP ceiling on requests per worker
# BPD_LIMIT_SCALE=1             # multiplies the per-route limits (sign-in, claims…); raise only for load tests
# BPD_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net   # where the encrypted backup copy goes
# BPD_NOSTR=1                   # 0 turns off the off-site backup copy

# --- web push (optional; generated into data/vapid.json if unset) ---
# BPD_VAPID_PUBLIC=
# BPD_VAPID_PRIVATE=
# BPD_VAPID_SUBJECT=mailto:you@example.com

# --- Litestream backups (docker compose --profile backup up -d) ---
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_BUCKET=
# LITESTREAM_ENDPOINT=https://<account>.r2.cloudflarestorage.com
